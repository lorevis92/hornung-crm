{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/open-tax-year", "schedule": "0 6 1 * *" }
  ],
  "functions": {
    "api/extract-document.js": { "maxDuration": 300 },
    "api/retry-extraction.js": { "maxDuration": 300 },
    "api/reprocess-client-year.js": { "maxDuration": 300 },
    "api/extract-document-now.js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
