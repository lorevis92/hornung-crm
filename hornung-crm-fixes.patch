index 63ff92a..92de1b0 100644
--- a/.env.example
+++ b/.env.example
@@ -31,6 +31,12 @@ PUBLIC_SITE_URL=http://localhost:5173
 # Optional: BCC a copy of every automatic email to the office
 NOTIFY_BCC=
 
+# Self sign-up (/register): "true" requires clients to confirm their e-mail
+# before they can sign in (a branded confirmation link is sent through
+# Resend). Default/unset = accounts are activated immediately, no
+# confirmation e-mail at all. See api/register.js for details.
+REQUIRE_EMAIL_CONFIRMATION=false
+
 # Secret shared with the Vercel Cron Job that calls /api/open-tax-year.
 # Vercel automatically sends it as "Authorization: Bearer <value>" for
 # scheduled invocations when this env var is set on the project.
