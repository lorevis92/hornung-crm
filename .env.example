# ---------------------------------------------------------------------------
# Hornung Consulting CRM — environment variables
# Copy this file to `.env` for local development.
# On Vercel, add the same keys under Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- PUBLIC (browser) -------------------------------------------------------
# Leave BOTH empty to run the app in DEMO MODE (no database needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Identifier of this app inside the shared Supabase database.
# Keep 'hornung_crm'. WisiHealth uses its own id in the same database.
VITE_APP_ID=hornung_crm

# Optional: force the "current" tax year shown on the dashboard.
# If empty, the app uses (current calendar year - 1).
VITE_CURRENT_TAX_YEAR=

# --- SERVER ONLY (never exposed to the browser) -----------------------------
# Used by the serverless functions in /api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

RESEND_API_KEY=
# Verified sender on Resend, e.g. "Hornung Consulting <no-reply@hornungconsulting.ch>"
RESEND_FROM="Hornung Consulting <onboarding@resend.dev>"
# Where clients land after clicking the invitation link
PUBLIC_SITE_URL=http://localhost:5173
# Optional: BCC a copy of every automatic email to the office
NOTIFY_BCC=

# Self sign-up (/register): "true" requires clients to confirm their e-mail
# before they can sign in (a branded confirmation link is sent through
# Resend). Default/unset = accounts are activated immediately, no
# confirmation e-mail at all. See api/register.js for details.
REQUIRE_EMAIL_CONFIRMATION=false

# Secret shared with the Vercel Cron Job that calls /api/open-tax-year.
# Vercel automatically sends it as "Authorization: Bearer <value>" for
# scheduled invocations when this env var is set on the project.
# Genera con: openssl rand -base64 32
# CRON_SECRET=
# Day (format MM-DD) from which the new tax year is opened automatically
# each year. Defaults to "01-01" if left empty.
# AUTO_OPEN_MONTH_DAY=01-01

# The address that automatically receives the specialist role the first time
# it logs in after signing up on /register. Never a VITE_ variable — this
# must never reach the browser.
# OWNER_EMAIL=hornungconsulting@gmail.com
