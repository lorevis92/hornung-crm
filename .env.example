# ---------------------------------------------------------------------------
# Hornung Consulting CRM — front-end build variables (VITE_*) only.
# Copy to `.env` for local development.
#
# Everything server-side (database, R2 signing secret, Anthropic, Resend, ...)
# is a Worker secret, never a VITE_ variable: see .dev.vars.example and
# wrangler.toml. The browser never connects to the database; it only talks
# to our own /api, and if the server is not configured it shows a
# "not configured" error page — there is no offline/sample-data mode.
# ---------------------------------------------------------------------------

# Identifier of this app in the database. Keep 'hornung_crm'.
VITE_APP_ID=hornung_crm

# Optional: force the "current" tax year shown on the dashboard.
# If empty, the app uses (current calendar year - 1).
VITE_CURRENT_TAX_YEAR=
